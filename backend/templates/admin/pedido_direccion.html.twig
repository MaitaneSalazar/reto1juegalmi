{# Dirección a la que se envía el pedido (la que tenía el cliente al hacerlo) #}
{% set d = field.value ? field.value.direccion : null %}
{% if d %}
    <div class="direccion-envio">
        <strong>{{ d.calle }} {{ d.numero }}{% if d.piso %}, {{ d.piso }}{% endif %}</strong><br>
        <span class="text-muted">{{ d.codigoPostal }} {{ d.ciudad }} ({{ d.provincia }})</span>
        {% if not field.value.activo %}
            <br><span class="badge badge-secondary">El cliente ya no usa esta dirección</span>
        {% endif %}
    </div>
{% else %}
    <span class="text-muted">Sin dirección</span>
{% endif %}
