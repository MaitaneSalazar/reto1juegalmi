{# Productos de un pedido con su precio en el momento de la compra #}
<table class="table table-sm lineas-tabla">
    <thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr></thead>
    <tbody>
    {% for linea in field.value %}
        <tr>
            <td>{{ linea.producto.nombre }}</td>
            <td class="text-end">{{ linea.cantidad }}</td>
            <td class="text-end">{{ linea.precioUnitario|number_format(2, ',', '.') }} €</td>
            <td class="text-end">{{ linea.subtotal|number_format(2, ',', '.') }} €</td>
        </tr>
    {% endfor %}
    </tbody>
    <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end">{{ entity.instance.total|number_format(2, ',', '.') }} €</th></tr></tfoot>
</table>
