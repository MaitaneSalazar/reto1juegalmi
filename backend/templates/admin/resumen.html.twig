{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Resumen{% endblock %}

{% block main %}
    {% set estados = {
        recibida: 'Recibida', diagnostico: 'Diagnóstico', en_reparacion: 'En reparación',
        lista_para_recoger: 'Lista para recoger'
    } %}

    <h1 class="saludo">

        Hola, {{ app.user.nombre }}
    </h1>
    <p class="resumen-sub">{{ "now"|date("d/m/Y") }} · Esto es lo que hay hoy en la tienda.</p>

    <div class="resumen-tarjetas">
        <a class="tarjeta destacada" href="/admin/reparacion">
            <span class="numero">{{ reparaciones|length }}</span>
            <span class="texto">Reparaciones en curso</span>
            {% if para_recoger %}<span class="detalle">{{ para_recoger }} listas para recoger</span>{% endif %}
        </a>
        <a class="tarjeta oscura {{ retrasados ? 'aviso' }}" href="/admin/alquiler">
            <span class="numero">{{ retrasados|length }}</span>
            <span class="texto">Alquileres retrasados</span>
            <span class="detalle">{{ alquileres_activos }} activos en plazo</span>
        </a>
        <a class="tarjeta" href="/admin/pedido">
            <span class="numero">{{ por_enviar }}</span>
            <span class="texto">Pedidos por enviar</span>
            <span class="detalle">Pendientes o pagados</span>
        </a>
        <div class="tarjeta {{ stock_bajo ? 'aviso' }}">
            <span class="numero">{{ stock_bajo|length }}</span>
            <span class="texto">Productos con poco stock</span>
            <span class="detalle">{{ stock_minimo }} unidades o menos</span>
        </div>
    </div>

    <div class="resumen-listas">
        <section>
            <h2>Alquileres retrasados</h2>
            {% for a in retrasados %}
                <a class="fila" href="/admin/alquiler/{{ a.id }}">
                    <strong>{{ a.cliente.nombre }} {{ a.cliente.apellido1 }}</strong>
                    <span>{{ a.lineas|filter(l => not l.fechaDevolucion)|map(l => l.videojuego.nombre)|join(', ') }}</span>
                    <span class="badge badge-danger">Desde el {{ a.fechaFinPrevista|date('d/m/Y') }}</span>
                </a>
            {% else %}
                <p class="text-muted">Ninguno. ¡Todo en plazo!</p>
            {% endfor %}
        </section>

        <section>
            <h2>Reparaciones en curso</h2>
            {% for r in reparaciones|slice(0, 6) %}
                <a class="fila" href="/admin/reparacion/{{ r.id }}">
                    <strong>{{ r.marca }} {{ r.modelo }}</strong>
                    <span>{{ r.cliente.nombre }} · {{ r.nombreTrabajadorActual }}</span>
                    <span class="badge badge-{{ r.estadoActual == 'lista_para_recoger' ? 'success' : (r.estadoActual == 'en_reparacion' ? 'info' : 'secondary') }}">{{ estados[r.estadoActual] ?? r.estadoActual }}</span>
                </a>
            {% else %}
                <p class="text-muted">No hay reparaciones en curso.</p>
            {% endfor %}
        </section>

        <section>
            <h2>Poco stock</h2>
            {% for p in stock_bajo %}
                <a class="fila" href="/admin/{{ p.tipo }}/{{ p.id }}/edit">
                    <strong>{{ p.nombre }}</strong>
                    <span>{{ p.tipo|capitalize }}</span>
                    <span class="badge badge-{{ 'danger' }}">{{ p.stock }} en stock</span>
                </a>
            {% else %}
                <p class="text-muted">Todo el catálogo tiene stock suficiente.</p>
            {% endfor %}
        </section>
    </div>
{% endblock %}
