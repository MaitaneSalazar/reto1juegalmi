{# Imagen de un producto en la web: la miniatura del worker y, si aún no existe, la original #}
{% if field.value %}
    {% set partes = field.value|split('.') %}
    {% set mini = partes|slice(0, partes|length - 1)|join('.') ~ '_mini.' ~ partes|last %}
    <a href="{{ field.value }}" target="_blank" title="Ver la imagen original">
        <img src="{{ mini }}" alt="" class="foto-producto"
             onerror="this.onerror=null; this.src='{{ field.value }}';">
    </a>
{% else %}
    <span class="foto-producto sin-imagen" title="Sin imagen"><i class="fa fa-image"></i></span>
{% endif %}
