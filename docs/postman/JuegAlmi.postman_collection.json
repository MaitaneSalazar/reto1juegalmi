      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ubicación del móvil, como mandan las apps (opcional)",
          "pm.request.headers.upsert({ key: 'X-Lat', value: pm.collectionVariables.get('lat') });",
          "pm.request.headers.upsert({ key: 'X-Lon', value: pm.collectionVariables.get('lon') });"
        ]
      }
    }
  ],
