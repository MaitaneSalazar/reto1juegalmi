      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/estado",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "estado"
              ]
            },
            "description": "Prueba de conexión, sin token.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test('Estado ok', () => pm.expect(pm.response.json().estado).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Sesión",
      "item": [
        {
          "name": "Login (cliente de prueba)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Guarda el token en la variable {{token}}. Ejecútalo antes que el resto.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_cliente}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.token);",
                  "pm.test('Trae token y usuario', () => { pm.expect(r.token).to.be.a('string'); pm.expect(r.usuario.email).to.eql(pm.collectionVariables.get('email_cliente')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro (usuario nuevo al azar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "registro"
              ]
            },
            "description": "Genera un DNI con su letra y un email nuevos en cada envío. No cambia el token guardado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba\",\n  \"apellido1\": \"Postman\",\n  \"apellido2\": \"\",\n  \"dni\": \"{{dni_nuevo}}\",\n  \"telefono\": \"600000000\",\n  \"email\": \"{{email_nuevo}}\",\n  \"password\": \"Abcd1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Math.floor(10000000 + Math.random() * 89999999);",
                  "pm.variables.set('dni_nuevo', n + 'TRWAGMYFPDXBNJZSQVHLCKE'[n % 23]);",
                  "pm.variables.set('email_nuevo', 'postman.' + Date.now() + '@juegalmi.es');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.test('Trae token', () => pm.expect(pm.response.json().token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
