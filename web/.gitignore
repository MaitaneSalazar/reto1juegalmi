# ==========================================================
# web/.gitignore — Web de gestión
# Pensado para un front en Angular. Si la web se hace con Twig
# dentro de Symfony, esta carpeta no hace falta.
# ==========================================================

# ---- Dependencias (se instalan con: npm install) ----
node_modules/

# ---- Compilación ----
/dist/
/.angular/
.sass-cache/

# ---- Variables de entorno locales ----
.env
.env.local

# ---- Logs ----
npm-debug.log*
