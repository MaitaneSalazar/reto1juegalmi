<?xml version="1.0" encoding="utf-8"?>
<!-- MIS REPARACIONES (14 del mockup). Sub-pestaña del Taller -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".taller.MisReparacionesFragment">

    <!-- El paddingBottom es para que la barra inferior flotante no tape la última tarjeta -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReparaciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/lista_entra"
        android:paddingBottom="120dp"
        android:visibility="gone" />

    <com.airbnb.lottie.LottieAnimationView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/pbReparaciones"
        android:layout_width="72dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="64dp"
        android:contentDescription="@string/cargando"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/cargando" />

    <LinearLayout
        android:id="@+id/llReparacionesAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReparacionesAvisoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/color_texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReparacionesAvisoTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/color_texto_suave"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReparacionesAviso"
            style="@style/BotonPrincipal"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />
    </LinearLayout>
</FrameLayout>