<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/vPasoLineaArriba"
            android:layout_width="2dp"
            android:layout_height="10dp"
            android:layout_gravity="center_horizontal|top" />

        <View
            android:id="@+id/vPasoLineaAbajo"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp" />

        <View
            android:id="@+id/vPasoPunto"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="3dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPasoNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPasoFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/color_texto_tenue"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPasoDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_texto_suave"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>