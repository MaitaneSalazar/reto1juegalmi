<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior de las pestañas: menú lateral, logo y marca. La lupa solo se enseña donde se puede buscar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivBarraMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu"
        android:padding="8dp"
        android:src="@drawable/ic_menu"
        app:tint="@color/color_texto_suave" />

    <TextView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_logo"
        android:gravity="center"
        android:text="J"
        android:textColor="@color/color_sobre_marca"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:letterSpacing="-0.03"
        android:text="@string/marca"
        android:textColor="@color/color_texto"
        android:textSize="21sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivBarraBuscar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circulo_hoja"
        android:contentDescription="@string/buscar"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="11dp"
        android:src="@drawable/ic_search"
        android:visibility="gone"
        app:tint="@color/color_texto" />
</LinearLayout>
