<?xml version="1.0" encoding="utf-8"?>
<!-- UNA LINEA DE LA CESTA: FOTO, NOMBRE, PRECIO Y LOS BOTONES DE MAS Y MENOS -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/color_hoja"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="92dp"
            app:cardBackgroundColor="@color/color_pozo"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivCestaFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCestaNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_texto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- SOLO EN LOS ALQUILERES: "Alquiler · 3 dias" -->
            <TextView
                android:id="@+id/tvCestaDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/color_texto_suave"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCestaPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/color_texto"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MAS ARRIBA, CANTIDAD Y MENOS ABAJO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pildora_pozo"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivCestaSumar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cesta_sumar"
                android:padding="10dp"
                android:src="@drawable/ic_mas"
                app:tint="@color/color_texto" />

            <TextView
                android:id="@+id/tvCestaCantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_texto"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCestaRestar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cesta_restar"
                android:padding="10dp"
                android:src="@drawable/ic_menos"
                app:tint="@color/color_texto_suave" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
