<?xml version="1.0" encoding="utf-8"?>
<!-- PESTAÑA GALERIA, LAS FOTOS DE LA TIENDA EN MOSAICO -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".nosotros.GaleriaFragment">

    <!-- EL PADDING DE ABAJO ES PARA QUE LA BARRA FLOTANTE NO TAPE LA ULTIMA FOTO -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGaleria"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/lista_entra"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="120dp"
        tools:listitem="@layout/item_foto_tienda" />

    <com.airbnb.lottie.LottieAnimationView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/pbGaleria"
        android:layout_width="72dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="64dp"
        android:contentDescription="@string/cargando"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/cargando" />

    <TextView
        android:id="@+id/tvGaleriaAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/color_texto_suave"
        android:visibility="gone" />
</FrameLayout>
