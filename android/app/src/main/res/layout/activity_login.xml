<?xml version="1.0" encoding="utf-8"?>
<!-- PANTALLA DE LOGIN -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical"
    tools:context=".sesion.LoginActivity">

    <!-- BARRA DE ARRIBA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- LOGO DE JUEGALMI -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_juegalmi" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:letterSpacing="-0.03"
            android:text="@string/marca"
            android:textColor="@color/color_texto"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoginCrearCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"
            android:text="@string/crear_cuenta"
            android:textColor="@color/color_marca_texto"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.05"
                android:text="@string/login_titulo"
                android:textColor="@color/color_texto"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="288dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="36dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/login_subtitulo"
                android:textColor="@color/color_texto_suave"
                android:textSize="15sp" />

            <TextView
                style="@style/Etiqueta"
                android:labelFor="@id/etLoginEmail"
                android:text="@string/email" />

            <EditText
                android:id="@+id/etLoginEmail"
                style="@style/Campo"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etLoginPassword"
                android:text="@string/password" />

            <EditText
                android:id="@+id/etLoginPassword"
                style="@style/Campo"
                android:autofillHints="password"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/tvLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_error"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="@color/color_alerta_texto"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginEntrar"
                style="@style/BotonPrincipal"
                android:layout_marginTop="28dp"
                android:text="@string/entrar" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:text="@string/pie"
        android:textColor="@color/color_texto_tenue"
        android:textSize="11sp" />
</LinearLayout>