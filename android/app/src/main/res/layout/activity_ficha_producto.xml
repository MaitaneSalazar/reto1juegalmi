<?xml version="1.0" encoding="utf-8"?>
<!-- FICHA DE PRODUCTO, LA MISMA PARA TODOS. LO DE ALQUILAR SOLO SALE EN LOS JUEGOS -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical"
    tools:context=".FichaProductoActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FOTO GRANDE CON EL BOTON DE VOLVER Y LA PLATAFORMA ENCIMA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="360dp">

                <ImageView
                    android:id="@+id/ivFichaFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_pozo"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <include
                    layout="@layout/barra_volver"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp" />

            </FrameLayout>

            <ProgressBar
                android:id="@+id/pbFicha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:indeterminateTint="@color/color_marca" />

            <TextView
                android:id="@+id/tvFichaError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/color_texto_suave"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llFichaDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFichaNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.03"
                    android:textColor="@color/color_texto"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- ETIQUETAS: PLATAFORMAS, GENERO Y PEGI EN LOS JUEGOS, LA MARCA EN EL RESTO -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llFichaEtiquetas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFichaEtiqueta1"
                            style="@style/EtiquetaFicha" />

                        <TextView
                            android:id="@+id/tvFichaEtiqueta2"
                            style="@style/EtiquetaFicha"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvFichaDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/color_texto_suave"
                    android:textSize="15sp" />

                <!-- COMPRAR O ALQUILAR, SOLO EN LOS JUEGOS -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tlFichaModo"
                    style="@style/PestanasTienda"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_pildora_pozo"
                    android:padding="4dp"
                    android:visibility="gone"
                    app:tabIndicator="@drawable/bg_pildora_hoja"
                    app:tabMode="fixed">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tienda_alquilar" />
                </com.google.android.material.tabs.TabLayout>

                <!-- LOS DIAS DE ALQUILER, SE ELIGE UNO CON UN TOQUE -->
                <LinearLayout
                    android:id="@+id/llFichaDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvFichaDia1"
                        style="@style/DiaAlquiler" />

                    <TextView
                        android:id="@+id/tvFichaDia3"
                        style="@style/DiaAlquiler"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tvFichaDia5"
                        style="@style/DiaAlquiler"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tvFichaDia7"
                        style="@style/DiaAlquiler"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- PIE CON EL PRECIO Y EL BOTON, SIEMPRE A LA VISTA -->
    <LinearLayout
        android:id="@+id/llFichaPie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFichaPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_texto"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFichaPrecioDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_texto_suave"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFicha"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
