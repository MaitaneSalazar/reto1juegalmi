<?xml version="1.0" encoding="utf-8"?>
<!-- FICHA DE PRODUCTO (06 del mockup). La misma página para todos los productos.
     La parte de alquiler solo se enseña en los videojuegos. De momento vacía -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical"
    tools:context=".FichaProductoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <include layout="@layout/barra_volver" />

        <TextView
            style="@style/TituloPagina"
            android:text="@string/titulo_ficha" />

        <TextView
            style="@style/TextoPendiente"
            android:text="@string/pagina_en_construccion" />

        <!-- Parte de ALQUILER: oculta por defecto. El código la enseña solo si el producto se alquila -->
        <LinearLayout
            android:id="@+id/llFichaAlquiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_hoja"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ficha_alquiler_pendiente"
                android:textColor="@color/color_texto_suave"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>