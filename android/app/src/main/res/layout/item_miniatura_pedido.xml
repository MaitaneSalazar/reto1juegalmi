<?xml version="1.0" encoding="utf-8"?>
<!-- FOTO PEQUEÑA DE UN PRODUCTO DEL PEDIDO CON SU xCANTIDAD ARRIBA A LA DERECHA -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="64dp"
    android:layout_marginEnd="8dp"
    app:cardBackgroundColor="@color/color_pozo"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <ImageView
        android:id="@+id/ivMiniatura"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- SOLO SI SE HA COGIDO MAS DE UNO -->
    <TextView
        android:id="@+id/tvMiniaturaCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:background="@drawable/bg_pildora_hoja"
        android:backgroundTint="@color/color_oscuro"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</androidx.cardview.widget.CardView>
