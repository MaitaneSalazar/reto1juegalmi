<?xml version="1.0" encoding="utf-8"?>
<!-- EDITAR DATOS PERSONALES (18 del mockup). De momento vacía: solo botón de volver y título -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical"
    tools:context=".EditarDatosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <include layout="@layout/barra_volver" />

        <TextView
            style="@style/TituloPagina"
            android:text="@string/titulo_editar_datos" />

        <TextView
            style="@style/TextoPendiente"
            android:text="@string/pagina_en_construccion" />
    </LinearLayout>
</LinearLayout>