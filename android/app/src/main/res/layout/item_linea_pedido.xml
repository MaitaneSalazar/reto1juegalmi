<?xml version="1.0" encoding="utf-8"?>
<!-- UNA LINEA DE UN PEDIDO EN "VER MAS": FOTO, NOMBRE, "2 × 59,99 €" Y SUBTOTAL -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivLineaFoto"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_miniatura"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLineaNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_texto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLineaCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_texto_suave"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLineaSubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/color_texto"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>