<?xml version="1.0" encoding="utf-8"?>
<!-- INICIO (03 del mockup). De momento: barra superior, saludo y tarjeta de reparación -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    tools:context=".InicioFragment">

    <include layout="@layout/barra_superior" />

    <TextView
        android:id="@+id/tvInicioHola"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="-0.05"
        android:textColor="@color/color_texto"
        android:textSize="44sp"
        android:textStyle="bold"
        tools:text="Hola, Ane" />

    <!-- Tarjeta calamina: qué reparamos y botón para pedirlo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_hero"
        android:clipToOutline="true"
        android:clipToPadding="false"
        android:padding="24dp">

        <!-- Herramienta de fondo, casi transparente y cortada por la esquina -->
        <ImageView
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-48dp"
            android:layout_marginEnd="-48dp"
            android:alpha="0.12"
            android:importantForAccessibility="no"
            android:rotation="12"
            android:src="@drawable/ic_handyman"
            app:tint="@color/color_sobre_marca" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

                <com.google.android.material.chip.Chip
                    style="@style/ChipCristal"
                    android:text="@string/cat_consolas" />

                <com.google.android.material.chip.Chip
                    style="@style/ChipCristal"
                    android:text="@string/cat_moviles" />

                <com.google.android.material.chip.Chip
                    style="@style/ChipCristal"
                    android:text="@string/cat_mandos" />

                <com.google.android.material.chip.Chip
                    style="@style/ChipCristal"
                    android:text="@string/cat_tablets" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:letterSpacing="-0.05"
                android:text="@string/lo_reparamos"
                android:textColor="@color/color_sobre_marca"
                android:textSize="40sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInicioPedirReparacion"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="@string/pedir_reparacion"
                android:textAllCaps="false"
                android:textColor="@color/color_marca"
                android:textSize="14sp"
                app:backgroundTint="@color/color_sobre_marca"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="end"
                app:iconSize="18dp"
                app:iconTint="@color/color_marca" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
