<?xml version="1.0" encoding="utf-8"?>
<!-- PESTAÑA UBICACION: PLANO, DIRECCION, HORARIO, TELEFONO Y COMO LLEGAR -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="120dp"
    tools:context=".nosotros.UbicacionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- MAPA DE OPENSTREETMAP CON EL PIN EN EL CENTRO. ES FIJO: AL TOCARLO SE ABRE "COMO LLEGAR" -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="224dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <org.osmdroid.views.MapView
                android:id="@+id/mvUbicacion"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_mapa"
                android:contentDescription="@null"
                android:padding="18dp"
                android:src="@drawable/ic_location"
                app:tint="@color/color_sobre_marca" />

            <!-- CAPA TRANSPARENTE ENCIMA: RECOGE EL TOQUE Y EVITA QUE EL MAPA SE MUEVA AL HACER SCROLL -->
            <View
                android:id="@+id/vUbicacionMapaToque"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/nosotros_como_llegar"
                android:focusable="true" />
        </androidx.cardview.widget.CardView>

        <com.airbnb.lottie.LottieAnimationView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/pbUbicacion"
            android:layout_width="72dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/cargando"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/cargando" />

        <TextView
            android:id="@+id/tvUbicacionError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/nosotros_error"
            android:textColor="@color/color_texto_suave"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llUbicacionDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- DIRECCION, VIENE DE LA API -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta_hoja"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvUbicacionLinea1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_texto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUbicacionLinea2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_texto_suave"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- HORARIO, ESCRITO EN LA APP -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_hoja"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/color_texto_suave" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/nosotros_horario_semana"
                        android:textColor="@color/color_texto"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nosotros_dias_semana"
                        android:textColor="@color/color_texto_suave"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nosotros_horario_sabado"
                        android:textColor="@color/color_texto"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nosotros_dias_sabado"
                        android:textColor="@color/color_texto_suave"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- TELEFONO, AL PULSAR SE ABRE EL MARCADOR -->
                <LinearLayout
                    android:id="@+id/llUbicacionTelefono"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_hoja"
                    android:backgroundTint="@color/color_oscuro"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_telefono"
                        app:tint="@color/color_fondo" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvUbicacionTelefono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_fondo"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComoLlegar"
                style="@style/BotonPrincipal"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/nosotros_como_llegar"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart"
                app:iconTint="@color/color_sobre_marca" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
