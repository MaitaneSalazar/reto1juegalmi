<?xml version="1.0" encoding="utf-8"?>
<!-- DATOS PERSONALES (17 del mockup). De momento vacía: solo botón de volver y título -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical"
    tools:context=".DatosPersonalesActivity">

    <!-- El padding de los lados va aquí dentro: el de "main" lo pone el código para no quedar debajo de las barras del sistema -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <include layout="@layout/barra_volver" />

        <TextView
            style="@style/TituloPagina"
            android:text="@string/menu_datos_personales" />

        <TextView
            style="@style/TextoPendiente"
            android:text="@string/pagina_en_construccion" />
    </LinearLayout>
</LinearLayout>