<?xml version="1.0" encoding="utf-8"?>
<!-- TIENDA (04/05 del mockup). De momento: barra superior con lupa y título -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    tools:context=".TiendaFragment">

    <include layout="@layout/barra_superior" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="-0.05"
        android:text="@string/tienda"
        android:textColor="@color/color_texto"
        android:textSize="44sp"
        android:textStyle="bold" />

    <!-- PRUEBA: quitar cuando esté la lista de productos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPruebaFichaJuego"
        style="@style/BotonPrincipal"
        android:layout_marginTop="24dp"
        android:text="@string/prueba_ver_ficha_juego" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPruebaFichaProducto"
        style="@style/BotonPrincipal"
        android:layout_marginTop="12dp"
        android:text="@string/prueba_ver_ficha_producto" />
</LinearLayout>
