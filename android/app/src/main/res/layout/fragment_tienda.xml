<?xml version="1.0" encoding="utf-8"?>
<!-- PANTALLA DE LA TIENDA, PARA COMPRAR Y PARA ALQUILAR -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".tienda.TiendaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <include layout="@layout/barra_superior" />

        <TextView
            android:id="@+id/tvTiendaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="-0.05"
            android:text="@string/tienda"
            android:textColor="@color/color_texto"
            android:textSize="44sp"
            android:textStyle="bold" />

        <!-- COMPRAR O ALQUILAR -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tlTiendaModo"
            style="@style/PestanasTienda"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pildora_pozo"
            android:padding="4dp"
            app:tabIndicator="@drawable/bg_pildora_hoja"
            app:tabIndicatorColor="@color/color_hoja"
            app:tabMaxWidth="0dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/color_texto">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tienda_comprar" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tienda_alquilar" />
        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>

    <!-- PESTAÑAS DE CATEGORIAS (O PLATAFORMAS EN ALQUILER), LAS PONE EL CODIGO -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tlTiendaFiltros"
        style="@style/PestanasTienda"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:tabIndicator="@drawable/bg_nav"
        app:tabIndicatorColor="@color/color_oscuro"
        app:tabMode="scrollable"
        app:tabPaddingEnd="16dp"
        app:tabPaddingStart="16dp"
        app:tabSelectedTextColor="@color/color_fondo" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpTienda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <!-- BUSCADOR: LA LUPA LO ABRE AQUI, DENTRO DE LA TIENDA, EN LUGAR DE LAS PESTAÑAS Y LA LISTA -->
    <FrameLayout
        android:id="@+id/fcvTiendaBuscar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>