<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de cada tipo de dispositivo: calamina si está elegido, blanco si no -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/color_marca" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/color_hoja" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>