<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- TEMA DE LA APP -->
    <style name="Base.Theme.RetoIndividual_1" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_marca</item>
        <item name="colorOnPrimary">@color/color_sobre_marca</item>
        <item name="colorPrimaryContainer">@color/color_marca_suave</item>
        <item name="colorOnPrimaryContainer">@color/color_marca_texto</item>
        <item name="colorSecondary">@color/color_alquiler</item>
        <item name="colorError">@color/color_alerta</item>
        <item name="android:colorBackground">@color/color_fondo</item>
        <item name="colorSurface">@color/color_hoja</item>
        <item name="colorOnSurface">@color/color_texto</item>
        <item name="colorOnSurfaceVariant">@color/color_texto_suave</item>
        <item name="colorOutline">@color/color_borde_fuerte</item>
        <item name="android:windowBackground">@color/color_fondo</item>
        <item name="android:textColorPrimary">@color/color_texto</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.RetoIndividual_1" parent="Base.Theme.RetoIndividual_1" />

    <!-- ETIQUETA ENCIMA DE CADA CAMPO -->
    <style name="Etiqueta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/color_texto_suave</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- CAMPO DE TEXTO -->
    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:textColorHint">@color/color_texto_tenue</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- BOTON PRINCIPAL -->
    <style name="BotonPrincipal" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="backgroundTint">@color/color_marca</item>
        <item name="android:textColor">@color/color_sobre_marca</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- CHIP DE LA TARJETA DE INICIO, SOLO INFORMA, NO SE PULSA -->
    <style name="ChipCristal" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipBackgroundColor">@color/blanco_cristal</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/blanco_cristal_borde</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:clickable">false</item>
        <item name="android:textColor">@color/color_sobre_marca</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- PESTAÑA DE LA BARRA DE ABAJO, LA ACTIVA SE ABRE CON SU NOMBRE -->
    <style name="PestanaNav">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="PestanaNavIcono">
        <item name="android:layout_width">21dp</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/blanco_tenue</item>
    </style>

    <style name="PestanaNavTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/color_sobre_marca</item>
        <item name="android:textSize">13sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Grupo de opciones del menú lateral: tarjeta blanca -->
    <style name="GrupoMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_tarjeta_hoja</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Opción del menú lateral: icono a la izquierda y texto -->
    <style name="ItemMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:drawableTint">@color/color_texto_suave</item>
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Título grande de las páginas secundarias -->
    <style name="TituloPagina">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SubtituloPagina">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/color_texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Aviso de página sin terminar (se quitará al hacer cada página) -->
    <style name="TextoPendiente">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">@color/color_texto_tenue</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
