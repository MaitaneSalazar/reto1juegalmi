<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PESTAÑAS DE LA TIENDA EN FORMA DE PILDORA, LA ELEGIDA SE RELLENA ENTERA -->
    <style name="PestanasTienda" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabTextColor">@color/color_texto_suave</item>
        <item name="tabTextAppearance">@style/TextoPestanaTienda</item>
        <item name="tabSelectedTextAppearance">@style/TextoPestanaTienda</item>
    </style>

    <style name="TextoPestanaTienda" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
